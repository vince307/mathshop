# Build context for the Dockerfile. Secrets never enter the image: the app reads them at runtime from the server's
# env file (/opt/apps/matmaverse/.env).
.env*
.vercel
.wrangler
node_modules
dist
.astro
.git
.github
.husky
.claude
.mcp.json
.vscode
.idea
# Not imported by the build (design mockups, scratch output, the code-review agent package).
assets/
outputs/
packages/
# Tests, docs and Supabase config/migrations (migrations reach the server through the deploy job, not the image).
tests
e2e
playwright-report
test-results
blob-report
coverage
context
docs
supabase/*
# Except the auth e-mail templates, which the image serves at /email-templates/ (see Dockerfile).
!supabase/templates
*.log
.DS_Store
