dist/

# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production
.env.test

# vercel
.vercel

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# local secrets (move to a password manager; do not VCS)
supabase password.txt

# legacy build caches (left over from removed adapters)
.wrangler/

# Claude Code config, skills, and local settings (do not VCS)
.claude/

# scratch / design reference material (mockups, scraped pages, minified vendor
# JS) — not source; must not be linted or committed
assets/
coverage/

# playwright artifacts
playwright-report/
test-results/
blob-report/
.playwright-mcp/

# Working files from AI skills and agent runs (plans, research, run logs,
# archives). They stay on the maintainer's machine, out of the repo. Kept in
# git: context/foundation (product/stack/infra docs CLAUDE.md points at),
# docs/reference (RLS docs) and the AI-review rubric the review gate reads.
context/*
!context/foundation/
!context/team/
context/team/*
!context/team/code-review-dod.md
docs/superpowers/
outputs/

# Local skill lockfile
skills-lock.json
