# Test-only environment for the cross-account isolation suite
# (tests/child-profiles-isolation.test.ts). Copy to `.env.test` and fill from
# the local Supabase stack: `npx supabase start` then `npx supabase status -o env`.
#
# Map the `supabase status -o env` output to these names:
#   API_URL          -> SUPABASE_URL
#   ANON_KEY         -> SUPABASE_ANON_KEY
#   SERVICE_ROLE_KEY -> SUPABASE_SERVICE_ROLE_KEY
#
# NOTE: the local-stack anon/service-role keys are fixed *public demo* JWTs
# (identical on every machine, signed with Supabase's default local JWT secret).
# They are NOT secrets — CI reads them straight from `supabase status`, no GitHub
# secrets required. Never reuse these keys for any deployed environment.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# HMAC key for the parent-verified session marker (S-07 parent-PIN gate). Any
# non-empty string works locally; on Vercel set PARENT_SESSION_SECRET to a strong
# random value (Production + Preview).
PARENT_SESSION_SECRET=test-parent-session-secret-0123456789
