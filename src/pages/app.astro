---
import Layout from "@/layouts/Layout.astro";
import { buttonVariants } from "@/components/ui/button";
import { ShoppingCart, LogOut } from "lucide-react";
import { t } from "@/i18n";

// Gated by middleware (`/app` ∈ PROTECTED_ROUTES) — an anonymous request never
// reaches here. `locals.user` is therefore always set, but we read defensively.
const { user } = Astro.locals;

// --- Part B extension point ---------------------------------------------------
// S-01b replaces this placeholder body with the profile-count router: read the
// parent's `child_profiles` count and branch 0 → create-first-profile wizard,
// 1 → straight into that child's start screen, 2+ → profile picker. The gating +
// the post-auth funnel into `/app` (signin + confirm both land here) stay as-is.
// -----------------------------------------------------------------------------
---

<Layout title={t.landing.title}>
  <div class="bg-background flex min-h-screen items-center justify-center p-4">
    <div
      class="bg-card text-card-foreground border-border w-full max-w-md rounded-2xl border p-8 text-center shadow-sm"
    >
      <span
        class="bg-primary text-primary-foreground mx-auto mb-4 inline-flex size-12 items-center justify-center rounded-2xl shadow-sm"
      >
        <ShoppingCart className="size-6" />
      </span>
      <h1 class="text-foreground mb-4 text-3xl font-extrabold">
        {t.brand}
      </h1>
      <p class="text-muted-foreground">
        {t.landing.signedIn}
        <span class="text-foreground block font-semibold">{user?.email}</span>
      </p>
      <form method="POST" action="/api/auth/signout" class="mt-6">
        <button type="submit" class:list={buttonVariants({ variant: "outline", size: "lg", className: "font-medium" })}>
          <LogOut className="size-4" />
          {t.landing.signOut}
        </button>
      </form>
    </div>
  </div>
</Layout>
