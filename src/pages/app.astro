---
import { createClient } from "@/lib/supabase";
import { countChildProfiles, resolveLandingPath } from "@/lib/services/child-profiles";

// Profile-count router (S-01b). Gated by middleware (`/app` ∈ PROTECTED_ROUTES),
// so `locals.user` is always set here. Both signin and confirm-email funnel into
// `/app`; this branch decides where the parent lands:
//   0 profiles  → create-first-profile wizard (/app/new-profile)
//   1 profile   → that child's start screen (/app/start)
//   2+ profiles → most-recent profile's start screen (the picker UI is S-07)
const supabase = createClient(Astro.request.headers, Astro.cookies);
const count = supabase ? await countChildProfiles(supabase) : 0;
return Astro.redirect(resolveLandingPath(count));
---
