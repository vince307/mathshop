---
import Layout from "@/layouts/Layout.astro";
import { t } from "@/i18n";

// Gated by middleware (`/app` ∈ PROTECTED_ROUTES) — an anonymous request never
// reaches here. `locals.user` is therefore always set, but we read defensively.
const { user } = Astro.locals;

// --- Part B extension point ---------------------------------------------------
// S-01b replaces this placeholder body with the profile-count router: read the
// parent's `child_profiles` count and branch 0 → create-first-profile wizard,
// 1 → straight into that child's start screen, 2+ → profile picker. The gating +
// the post-auth funnel into `/app` (signin + confirm both land here) stay as-is.
// -----------------------------------------------------------------------------
---

<Layout title={t.landing.title}>
  <div class="bg-background flex min-h-screen items-center justify-center p-4">
    <div class="bg-card text-card-foreground border-border rounded-2xl border p-8 text-center shadow-sm">
      <h1 class="text-primary mb-4 text-3xl font-bold">
        {t.brand}
      </h1>
      <p class="text-muted-foreground">
        {t.landing.signedIn}
        <span class="text-foreground block font-semibold">{user?.email}</span>
      </p>
      <form method="POST" action="/api/auth/signout" class="mt-6">
        <button
          type="submit"
          class="border-input text-foreground hover:bg-muted rounded-lg border px-4 py-2 text-sm transition-colors"
        >
          {t.landing.signOut}
        </button>
      </form>
    </div>
  </div>
</Layout>
