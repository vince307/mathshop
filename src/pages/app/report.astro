---
import Layout from "@/layouts/Layout.astro";
import AppShell from "@/components/app/AppShell.astro";
import { ShieldCheck, Check } from "lucide-react";
import WeeklyReport from "@/components/parent/WeeklyReport";
import ChangePinSection from "@/components/parent/ChangePinSection";
import DeleteAccountSection from "@/components/parent/DeleteAccountSection";
import type { ChildReport } from "@/components/parent/WeeklyReport";
import { buttonVariants } from "@/components/ui/button";
import { createClient } from "@/lib/supabase";
import { listChildProfiles, MAX_PROFILES_PER_ACCOUNT } from "@/lib/services/child-profiles";
import { getWeeklyReport } from "@/lib/services/reports";
import { PARENT_VERIFIED_COOKIE, verifyMarker } from "@/lib/services/parent-pin";
import { getAvatar } from "@/data/avatars";
import { t } from "@/i18n";

// Parent weekly report (S-07 / FR-016). Auth-gated under /app by middleware; this
// route ADDITIONALLY checks the signed parent_verified marker and redirects to the
// PIN gate whenever it's absent / expired / tampered — the report is a parent-only
// surface behind the soft PIN gate, not open to the child. Loads ONLY the acting
// parent's own profiles + their current-week reports (RLS-scoped, so no other
// account's data can appear). SSR by default (output: "server").
const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase) return Astro.redirect("/app/parent-pin");

const {
  data: { user },
} = await supabase.auth.getUser();
const marker = Astro.cookies.get(PARENT_VERIFIED_COOKIE)?.value;
if (!user || !verifyMarker(marker, user.id)) return Astro.redirect("/app/parent-pin");

const profiles = await listChildProfiles(supabase);
const reports: ChildReport[] = await Promise.all(
  profiles.map(async (profile) => {
    const avatar = getAvatar(profile.avatar);
    // A failed query surfaces as an honest per-child error card (report: null)
    // instead of masquerading as an empty week or 500ing the page (S-09).
    let report: ChildReport["report"] = null;
    try {
      report = await getWeeklyReport(supabase, profile.id);
    } catch {
      report = null;
    }
    return {
      profileId: profile.id,
      name: profile.name,
      avatarImage: avatar?.image ?? null,
      avatarAlt: avatar?.alt ?? "",
      report,
    };
  }),
);
---

<Layout title={t.brand}>
  <AppShell heading={t.report.heading} subtitle={t.report.intro} active="parent">
    <div class="grid items-start gap-6 lg:grid-cols-3">
      {/* ---------- Per-child report cards ---------- */}
      <div class="flex flex-col gap-6 lg:col-span-2 lg:col-start-1 lg:row-start-1">
        <WeeklyReport client:load reports={reports} />
      </div>

      {
        /* Account settings the gate already promises (t.parentPin.note): changing
          the parent PIN. Above the danger zone, and behind the same marker gate as
          the rest of this page — the route re-proves the current PIN itself. */
      }
      <div class="lg:col-span-2 lg:col-start-1 lg:row-start-2">
        <ChangePinSection client:load />
      </div>

      {
        /* Danger zone (MAT-17): whole-account deletion — typed e-mail + fresh PIN in
          the dialog. Last on the page at every width; stacking it above the ordinary
          actions on a phone would put deletion in the reader's path. */
      }
      <div class="order-last lg:order-none lg:col-span-2 lg:col-start-1 lg:row-start-3">
        <DeleteAccountSection client:load email={user.email ?? ""} />
      </div>

      {/* ---------- Rail: actions + how the environment is kept safe ---------- */}
      <aside class="flex flex-col gap-6 lg:col-start-3 lg:row-span-3 lg:row-start-1">
        <div class="flex flex-col gap-3">
          {
            /* Parent-side add-a-child entry (S-11) — hidden once the soft cap is reached. */
            profiles.length < MAX_PROFILES_PER_ACCOUNT && (
              <a href="/app/new-profile" class:list={[buttonVariants({ variant: "default", size: "lg" }), "w-full"]}>
                {t.report.addChild}
              </a>
            )
          }
          <a href="/app/start" class:list={[buttonVariants({ variant: "outline", size: "lg" }), "w-full"]}>
            {t.report.back}
          </a>
        </div>

        {/* Product guarantees, not measurements — safe to state without data. */}
        <div class="bg-card border-border rounded-3xl border p-5 shadow-sm">
          <p class="text-foreground flex items-center gap-2 font-extrabold">
            <ShieldCheck className="text-success size-5" />
            {t.report.safetyHeading}
          </p>
          <ul class="mt-3 flex flex-col gap-2">
            {
              t.report.safetyPoints.map((point) => (
                <li class="text-muted-foreground flex items-start gap-2 text-sm">
                  <Check className="text-success mt-0.5 size-4 shrink-0" />
                  {point}
                </li>
              ))
            }
          </ul>
        </div>
      </aside>
    </div>
  </AppShell>
</Layout>
