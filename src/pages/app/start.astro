---
import Layout from "@/layouts/Layout.astro";
import StartShiftButton from "@/components/child/StartShiftButton";
import { ShopArt } from "@/components/child/ShopArt";
import { buttonVariants } from "@/components/ui/button";
import { LogOut } from "lucide-react";
import { createClient } from "@/lib/supabase";
import { getMostRecentProfile } from "@/lib/services/child-profiles";
import { worldForTheme } from "@/data/worlds";
import { getAvatar } from "@/data/avatars";
import { nextUpgrade, readPurchased } from "@/data/upgrades";
import { t } from "@/i18n";

// Child start screen (S-01b). Gated under /app. Loads the parent's most-recent
// profile; the /app router only sends parents here when one exists, so the
// no-profile branch is a defensive fallback (direct nav with 0 profiles).
// Single themed business + an in-world tap prompt — no map. The coins/level HUD
// (S-04) surfaces the persisted balance + business level loaded with the profile.
// profile.name is consciously-collected PII — rendered ONLY as auto-escaped text
// (interpolation), never set:html.
const supabase = createClient(Astro.request.headers, Astro.cookies);
const profile = supabase ? await getMostRecentProfile(supabase) : null;

const world = profile ? worldForTheme(profile.theme) : null;
const avatar = profile ? getAvatar(profile.avatar) : null;
const greeting = profile ? t.start.greeting.replace("{name}", profile.name) : "";

// Owned upgrades (normalized, robust to pre-S-06 '{}' rows) drive the grown shop
// art + the "next upgrade" nudge. The nudge shows the gap to the cheapest
// level-eligible unowned upgrade the child can't yet afford; hidden when nothing
// is next (all owned / none eligible) or when it's already affordable (FR-013 —
// factual, no urgency).
const purchased = profile ? readPurchased(profile.shop_state) : [];
const next = profile ? nextUpgrade({ businessLevel: profile.business_level, purchased }) : null;
const showNext = !!(next && profile && profile.wallet_balance < next.cost);
const nextText =
  next && profile
    ? t.upgradeShop.nextProgress
        .replace("{amount}", String(next.cost - profile.wallet_balance))
        .replace("{name}", t.upgrades[next.id as keyof typeof t.upgrades].name)
    : "";
---

<Layout title={t.brand}>
  <div class="bg-background flex min-h-screen flex-col items-center px-4 py-10 sm:py-16">
    {/* Parent signout — subtle, top-right; child controls stay below */}
    <div class="mb-6 flex w-full max-w-md justify-end">
      <form method="POST" action="/api/auth/signout">
        <button
          type="submit"
          class="text-muted-foreground hover:text-foreground inline-flex items-center gap-1 text-sm transition-colors"
        >
          <LogOut className="size-4" />
          {t.nav.signOut}
        </button>
      </form>
    </div>

    {
      profile && world ? (
        <div class="w-full max-w-md">
          {/* Greeting */}
          <div class="flex items-center gap-3">
            {avatar && (
              <img
                src={avatar.image}
                alt={avatar.alt}
                class="border-primary size-14 rounded-full border-2 object-cover"
              />
            )}
            <div>
              <h1 class="text-foreground text-2xl font-extrabold">{greeting}</h1>
              <p class="text-muted-foreground text-sm">{t.start.subtitle}</p>
            </div>
          </div>

          {/* Wallet (Portfel) + business-level HUD (S-04/S-05) — persisted, cross-session totals */}
          <div class="mt-6 flex items-center gap-3">
            <div class="bg-card border-border flex items-center gap-2 rounded-full border px-3 py-1.5 shadow-sm">
              <img src="/illustrations/coin-stack.png" alt="" class="size-6 object-contain" loading="lazy" />
              <span class="sr-only">{t.start.walletLabel}</span>
              <span class="text-accent text-lg font-extrabold">{profile.wallet_balance}</span>
            </div>
            <div class="bg-secondary text-secondary-foreground rounded-full px-3 py-1.5 text-sm font-bold">
              {t.start.levelLabel.replace("{level}", String(profile.business_level))}
            </div>
          </div>
          <p class="text-muted-foreground mt-2 text-sm">{t.start.savingsHint}</p>

          {/* Single themed business — base world art + owned-upgrade badges (S-06) */}
          <div class="bg-card border-border mt-8 overflow-hidden rounded-3xl border shadow-sm">
            <ShopArt world={world} purchased={purchased} />
            <p class="text-foreground px-4 py-3 text-center text-lg font-bold">{world.name}</p>
          </div>

          {/* In-world tap prompt (coming-soon no-op until S-02+) */}
          <div class="mt-8 flex justify-center">
            <StartShiftButton client:load />
          </div>

          {/* Next-upgrade nudge — factual gap to the next upgrade (S-06, FR-013) */}
          {showNext && <p class="text-muted-foreground mt-6 text-center text-sm font-semibold">{nextText}</p>}

          {/* Spend the wallet: browse/choose upgrades (S-06) */}
          <div class="mt-4 flex justify-center">
            <a href="/app/upgrades" class:list={buttonVariants({ variant: "outline", size: "lg" })}>
              {t.start.upgradesLink}
            </a>
          </div>
        </div>
      ) : (
        <div class="bg-card border-border mt-16 w-full max-w-md rounded-2xl border p-8 text-center shadow-sm">
          <p class="text-muted-foreground mb-4">{t.profileWizard.subtitle}</p>
          <a href="/app/new-profile" class:list={buttonVariants({ variant: "default", size: "lg" })}>
            {t.profileWizard.title}
          </a>
        </div>
      )
    }
  </div>
</Layout>
