---
import Layout from "@/layouts/Layout.astro";
import ParentPinGate from "@/components/parent/ParentPinGate";
import BrandRow from "@/components/marketing/BrandRow.astro";
import { DECOR_PATH, DECOR_COIN_STACK, DECOR_CHART } from "@/data/marketing-art";
import { createClient } from "@/lib/supabase";
import { hasPin } from "@/lib/services/parent-pin";
import { t } from "@/i18n";

// Parent-PIN gate (S-07 / FR-016). Already auth-gated under /app by middleware.
// Whether the parent has a PIN decides set vs enter mode; the island posts to the
// server-authoritative routes and, on success, navigates to /app/report.
const supabase = createClient(Astro.request.headers, Astro.cookies);
const alreadyHasPin = supabase ? await hasPin(supabase) : false;
const mode = alreadyHasPin ? "enter" : "set";
---

<Layout title={t.brand}>
  <div class="bg-background relative flex min-h-screen flex-col items-center justify-center overflow-hidden px-4 py-10">
    {
      /* Ambient decoration (mockup `06`: a dotted path and coins across the top
        band). Same contract as `AuthShell`'s layer — `aria-hidden`,
        `pointer-events-none`, desktop-only, `z-0` against the content's `z-10`,
        and `overflow-hidden` above so nothing overhanging scrolls the body. */
    }
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 z-0 hidden lg:block">
      <img src={DECOR_PATH} alt="" class="absolute top-16 left-1/2 w-72 -translate-x-1/2 opacity-70" />
      <img src={DECOR_COIN_STACK} alt="" class="absolute top-24 right-16 w-24" />
      <img src={DECOR_CHART} alt="" class="absolute bottom-16 left-12 w-28 opacity-80" />
    </div>

    <div class="relative z-10 flex w-full flex-col items-center">
      <BrandRow size="lg" class="mb-6" />
      <ParentPinGate client:load mode={mode} />
    </div>
  </div>
</Layout>
