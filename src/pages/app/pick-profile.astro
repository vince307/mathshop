---
import Layout from "@/layouts/Layout.astro";
import { Plus } from "lucide-react";
import { AvatarCircle } from "@/components/child/AvatarCircle";
import { childCard } from "@/components/child/childCard";
import { createClient } from "@/lib/supabase";
import { listChildProfiles, MAX_PROFILES_PER_ACCOUNT } from "@/lib/services/child-profiles";
import { getAvatar } from "@/data/avatars";
import { t } from "@/i18n";

// Profile picker (S-11, FR-002). Gated under /app by middleware. Lists ONLY the
// authenticated parent's profiles (RLS-scoped) as oversized avatar+name tiles —
// names are required since avatars can repeat within an account. Each tile is a
// native form POST to /api/profiles/select (which proves ownership before
// setting the session cookie). Deliberately does NOT read the selection cookie
// (no resolution ladder here — prevents redirect loops on a stale id). The 0/1
// redirects are defensive; the /app router normally never lands those here.
// profile.name is consciously-collected PII — rendered only as escaped text.
const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase) return Astro.redirect("/auth/signin");

const profiles = await listChildProfiles(supabase);
if (profiles.length === 0) return Astro.redirect("/app");
if (profiles.length === 1) return Astro.redirect("/app/start");
---

<Layout title={t.brand}>
  <div class="bg-background flex min-h-screen flex-col items-center px-4 py-10 sm:py-16">
    <div class="w-full max-w-md text-center">
      <h1 class="text-foreground text-3xl font-extrabold">{t.picker.heading}</h1>
      <p class="text-muted-foreground mt-2">{t.picker.subtitle}</p>

      <div class="mt-8 flex flex-col gap-4">
        {
          profiles.map((profile) => {
            const avatar = getAvatar(profile.avatar);
            return (
              <form method="POST" action="/api/profiles/select">
                <input type="hidden" name="profileId" value={profile.id} />
                <button
                  type="submit"
                  aria-label={t.picker.tileLabel.replace("{name}", profile.name)}
                  class:list={childCard(
                    "3xl",
                    "hover:border-primary focus-visible:ring-ring flex min-h-20 w-full items-center gap-4 border-2 p-4 text-left transition-colors focus-visible:ring-2 focus-visible:outline-none active:scale-[0.99]",
                  )}
                >
                  {avatar && <AvatarCircle src={avatar.image} alt={avatar.alt} size={16} />}
                  <span class="text-foreground text-xl font-extrabold">{profile.name}</span>
                </button>
              </form>
            );
          })
        }

        {
          /* One-tap add-a-child entry (S-11) — hidden once the soft cap is reached. */
          profiles.length < MAX_PROFILES_PER_ACCOUNT && (
            <a
              href="/app/new-profile"
              class="border-border text-muted-foreground hover:border-primary hover:text-foreground focus-visible:ring-ring flex min-h-20 w-full items-center gap-4 rounded-3xl border-2 border-dashed p-4 text-left transition-colors focus-visible:ring-2 focus-visible:outline-none"
            >
              <span class="bg-primary/10 text-primary inline-flex size-16 items-center justify-center rounded-full">
                <Plus className="size-8" />
              </span>
              <span class="text-xl font-extrabold">{t.picker.addProfile}</span>
            </a>
          )
        }
      </div>
    </div>
  </div>
</Layout>
