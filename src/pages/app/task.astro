---
import Layout from "@/layouts/Layout.astro";
import ShiftScreen from "@/components/child/ShiftScreen";
import { LogOut } from "lucide-react";
import { createClient } from "@/lib/supabase";
import { getMostRecentProfile } from "@/lib/services/child-profiles";
import { worldForTheme } from "@/data/worlds";
import { t } from "@/i18n";

// Shift surface (S-04). Gated under /app. Loads the active profile and mounts the
// shift orchestrator, which generates a 5–10 task shift (mixing S-02 counting +
// S-03 change-making) from starting_level, runs it client-side, then persists the
// result once at shift end. Mid-shift state is never persisted (FR-016). Defensive
// fallbacks: no SSR client → sign-in; no profile → back to the /app router.
const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase) return Astro.redirect("/auth/signin");

const profile = await getMostRecentProfile(supabase);
if (!profile) return Astro.redirect("/app");

const world = worldForTheme(profile.theme);
---

<Layout title={t.brand}>
  <div class="bg-background flex min-h-screen flex-col items-center px-4 py-10 sm:py-16">
    {/* Parent signout — subtle, top-right; child controls stay below */}
    <div class="mb-6 flex w-full max-w-md justify-end">
      <form method="POST" action="/api/auth/signout">
        <button
          type="submit"
          class="text-muted-foreground hover:text-foreground inline-flex items-center gap-1 text-sm transition-colors"
        >
          <LogOut className="size-4" />
          {t.nav.signOut}
        </button>
      </form>
    </div>

    <ShiftScreen client:load startingLevel={profile.starting_level} world={world} profileId={profile.id} />
  </div>
</Layout>
