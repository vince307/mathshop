---
import Layout from "@/layouts/Layout.astro";
import AppShell from "@/components/app/AppShell.astro";
import ShiftScreen from "@/components/child/ShiftScreen";
import { createClient } from "@/lib/supabase";
import { resolvePageProfile } from "@/lib/services/active-profile";
import { worldForTheme } from "@/data/worlds";
import { getAvatar } from "@/data/avatars";
import { readPurchased, shiftBonusTasks } from "@/data/upgrades";
import { openShift } from "@/data/shift";
import { ceilingForLevel, readDifficultyState } from "@/data/adaptive";
import { t } from "@/i18n";

// Shift surface (S-04). Gated under /app. Loads the ACTIVE profile (S-11 fallback
// ladder: valid selection → sole profile → back to the /app router), plans the
// shift (mixing S-02 counting + S-03 change-making) from the profile's persisted
// difficulty, and mounts the orchestrator island, which draws the remaining
// tasks, plays them client-side and persists the result once at shift end. Mid-shift state is never persisted (FR-016). Defensive
// fallbacks: no SSR client → sign-in; no resolvable profile → the /app router.
// Chrome comes from the shared AppShell (ui-v2 `03-change-mission`); the mission
// itself stays a single island so its state survives every re-render.
const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase) return Astro.redirect("/auth/signin");

const { profile } = await resolvePageProfile(supabase, Astro.cookies);
if (!profile) return Astro.redirect("/app");

const world = worldForTheme(profile.theme);
const purchased = readPurchased(profile.shop_state);
const avatar = getAvatar(profile.avatar);

// The shift's PLAN is fixed HERE, once per request — its length, its seed, and
// the difficulty it opens at — together with task 1, which is drawn server-side
// and rendered into the SSR payload. Tasks 2…N are drawn in the island from that
// same seed (`useShiftEngine`), which is what lets a task be generated AFTER the
// previous one is scored — the precondition for in-shift adaptation (P5).
//
// The rule this replaced was "never generate in the island". That was too broad:
// what actually breaks is redrawing task 1, whose markup the server already
// rendered — a second draw at hydration mismatches the server tree and the child
// watches one task flip into another. Tasks 2…N have no server markup to
// contradict, and the shared seed makes them reproducible regardless. Owned
// upgrades lengthen the shift (capacity effect, S-06): a busier shop means more
// practice + more earning.
//
// Difficulty comes from the profile's persisted per-competency `d`, NOT from
// `starting_level` — age only seeds a fresh profile now. `readDifficultyState`
// normalises the jsonb defensively (`{}`, missing keys, garbage, off-scale) and
// clamps into the age band, so a row that predates the column needs no data
// migration: it reads as its `starting_level`-derived seed (`LEVEL_SEED`, which
// opens strictly below the age band so the engine has room to adapt UPWARD — a
// stored `d` is clamped to the band, never to the seed, so a profile already
// mid-play keeps its number). Shift LENGTH is derived from
// `max(d.math, d.money)` inside `planShift` and is fixed for the whole shift.
//
// The age-band ceiling travels in the plan so the island's in-shift adaptation
// (P5) honours the same guardrail: no streak of perfect answers carries a child
// past their band. It is a bound, not an authority — `recordShiftResult`
// recomputes the persisted `d` against its own `ceilingForLevel`.
const difficulty = readDifficultyState(profile.difficulty_state, profile.starting_level);
const ceiling = ceilingForLevel(profile.starting_level);
const { plan, firstTask } = openShift(difficulty, ceiling, shiftBonusTasks(purchased));
---

<Layout title={t.brand}>
  <AppShell
    heading={t.task.missionTitle}
    subtitle={world.name}
    active="missions"
    profile={{
      name: profile.name,
      avatarImage: avatar?.image ?? null,
      level: profile.business_level,
      wallet: profile.wallet_balance,
    }}
  >
    <ShiftScreen
      client:load
      plan={plan}
      firstTask={firstTask}
      world={world}
      profileId={profile.id}
      walletBalance={profile.wallet_balance}
      purchased={purchased}
    />
  </AppShell>
</Layout>
