---
import Layout from "@/layouts/Layout.astro";
import CountingTask from "@/components/child/CountingTask";
import { LogOut } from "lucide-react";
import { createClient } from "@/lib/supabase";
import { getMostRecentProfile } from "@/lib/services/child-profiles";
import { worldForTheme } from "@/data/worlds";
import { generateCountingTask } from "@/data/counting-tasks";
import { t } from "@/i18n";

// Counting-task surface (S-02). Gated under /app. Loads the active profile,
// generates a counting task from its starting_level (procedural, grades 1–2
// band), and mounts the tap-to-count island. Stateless — nothing is persisted
// (coins/level are S-04). Defensive fallbacks mirror the start screen: no SSR
// client → sign-in; no profile → back to the /app router, which resolves where
// the parent belongs (no dead-end).
const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase) return Astro.redirect("/auth/signin");

const profile = await getMostRecentProfile(supabase);
if (!profile) return Astro.redirect("/app");

const world = worldForTheme(profile.theme);
const task = generateCountingTask(profile.starting_level);
---

<Layout title={t.brand}>
  <div class="bg-background flex min-h-screen flex-col items-center px-4 py-10 sm:py-16">
    {/* Parent signout — subtle, top-right; child controls stay below */}
    <div class="mb-6 flex w-full max-w-md justify-end">
      <form method="POST" action="/api/auth/signout">
        <button
          type="submit"
          class="text-muted-foreground hover:text-foreground inline-flex items-center gap-1 text-sm transition-colors"
        >
          <LogOut className="size-4" />
          {t.nav.signOut}
        </button>
      </form>
    </div>

    <CountingTask client:load task={task} world={world} />
  </div>
</Layout>
