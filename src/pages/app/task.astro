---
import Layout from "@/layouts/Layout.astro";
import AppShell from "@/components/app/AppShell.astro";
import ShiftScreen from "@/components/child/ShiftScreen";
import { createClient } from "@/lib/supabase";
import { resolvePageProfile } from "@/lib/services/active-profile";
import { worldForTheme } from "@/data/worlds";
import { getAvatar } from "@/data/avatars";
import { readPurchased } from "@/data/upgrades";
import { t } from "@/i18n";

// Shift surface (S-04). Gated under /app. Loads the ACTIVE profile (S-11 fallback
// ladder: valid selection → sole profile → back to the /app router) and mounts the
// shift orchestrator, which generates a 5–10 task shift (mixing S-02 counting +
// S-03 change-making) from starting_level, runs it client-side, then persists the
// result once at shift end. Mid-shift state is never persisted (FR-016). Defensive
// fallbacks: no SSR client → sign-in; no resolvable profile → the /app router.
// Chrome comes from the shared AppShell (ui-v2 `03-change-mission`); the mission
// itself stays a single island so its state survives every re-render.
const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase) return Astro.redirect("/auth/signin");

const { profile } = await resolvePageProfile(supabase, Astro.cookies);
if (!profile) return Astro.redirect("/app");

const world = worldForTheme(profile.theme);
const purchased = readPurchased(profile.shop_state);
const avatar = getAvatar(profile.avatar);
---

<Layout title={t.brand}>
  <AppShell
    heading={t.task.missionTitle}
    subtitle={world.name}
    active="missions"
    profile={{
      name: profile.name,
      avatarImage: avatar?.image ?? null,
      level: profile.business_level,
      wallet: profile.wallet_balance,
    }}
  >
    <ShiftScreen
      client:load
      startingLevel={profile.starting_level}
      world={world}
      profileId={profile.id}
      walletBalance={profile.wallet_balance}
      purchased={purchased}
    />
  </AppShell>
</Layout>
