---
import Layout from "@/layouts/Layout.astro";
import AuthShell from "@/components/auth/AuthShell.astro";
import UpdatePasswordForm from "@/components/auth/UpdatePasswordForm";
import { HERO_RESET } from "@/data/marketing-art";
import { RESET_MARKER_COOKIE, verifyResetMarker } from "@/lib/services/password-reset";
import { t } from "@/i18n";

/**
 * Set-new-password screen — where the recovery link lands.
 *
 * MUST NOT be added to middleware's AUTH_FORM_PAGES: the recovery hop arrives
 * here WITH a session, so bouncing authenticated parents would break the flow at
 * its last step.
 *
 * The marker check below is UX (don't render a form that cannot be submitted);
 * the real gate is re-checked in /api/auth/update-password. A live session
 * without a marker means someone reached this page without a recovery link — so
 * they are sent to request one, not shown the form.
 */
const user = Astro.locals.user;
const marker = Astro.cookies.get(RESET_MARKER_COOKIE)?.value;

if (!user) {
  return Astro.redirect(`/auth/signin?error=${encodeURIComponent(t.auth.serverError.sessionExpired)}`);
}
if (!verifyResetMarker(marker, user.id)) {
  return Astro.redirect(`/auth/reset-password?error=${encodeURIComponent(t.auth.serverError.sessionExpired)}`);
}

const error = Astro.url.searchParams.get("error");
---

<Layout title={t.auth.updatePassword.title}>
  <AuthShell heading={t.marketing.parentPanel} accent={t.auth.updatePassword.heading}>
    <div class="bg-card text-card-foreground border-border shadow-mm-card rounded-3xl border p-6 sm:p-8">
      <div class="flex flex-col items-center text-center">
        {
          /* The same hero as `/auth/reset-password`, so the recovery flow's two
            steps read as one flow. This route has no mockup of its own. It MUST
            stay on the card: the PNG's white card is keyed out (`slice-map.md`). */
        }
        <img
          src={HERO_RESET}
          alt=""
          aria-hidden="true"
          width="402"
          height="264"
          class="h-auto w-60 max-w-full sm:w-72"
        />
        <h2 class="text-foreground mt-4 text-3xl font-extrabold">{t.auth.updatePassword.heading}</h2>
        <p class="text-muted-foreground mt-1 text-sm">{t.auth.updatePassword.description}</p>
      </div>

      <div class="mt-6">
        <UpdatePasswordForm serverError={error} client:load />
      </div>
    </div>
  </AuthShell>
</Layout>
