---
import Layout from "@/layouts/Layout.astro";
import { t } from "@/i18n";

const email = Astro.url.searchParams.get("email");
const resent = Astro.url.searchParams.get("resent") === "1";
const resendError = Astro.url.searchParams.get("error");

// With no email in the URL (direct nav, or a dev stack with confirmations off) we
// can't drive a resend, so show the simpler "account created" message. The real
// post-signup flow always carries ?email= and shows the check-your-email panel.
const isAutoConfirmed = import.meta.env.DEV && !email;
const content = isAutoConfirmed ? t.confirmEmail.autoConfirmed : t.confirmEmail.checkEmail;
---

<Layout title={content.heading}>
  <div class="bg-background flex min-h-screen items-center justify-center p-4">
    <div
      class="bg-card text-card-foreground border-border w-full max-w-sm rounded-2xl border p-8 text-center shadow-sm"
    >
      <div class="mb-4 text-5xl">{content.emoji}</div>
      <h1 class="text-foreground mb-3 text-2xl font-bold">
        {content.heading}
      </h1>
      <p class="text-muted-foreground mb-4">{content.description}</p>

      {
        email && !isAutoConfirmed && (
          <p class="text-muted-foreground mb-6 text-sm break-all">
            {t.confirmEmail.checkEmail.sentToPrefix} <span class="text-foreground font-medium">{email}</span>
          </p>
        )
      }

      {
        resent && (
          <p class="mb-4 rounded-lg border border-green-600/30 bg-green-50 px-3 py-2 text-sm text-green-700">
            {t.confirmEmail.checkEmail.resentNotice}
          </p>
        )
      }

      {
        resendError && (
          <p class="border-destructive/30 text-destructive mb-4 rounded-lg border bg-red-50 px-3 py-2 text-sm">
            {resendError}
          </p>
        )
      }

      {
        email && !isAutoConfirmed && (
          <form method="POST" action="/api/auth/resend" class="mb-6">
            <input type="hidden" name="email" value={email} />
            <button
              type="submit"
              class="border-input text-foreground hover:bg-muted w-full rounded-lg border px-4 py-2 text-sm font-medium transition"
            >
              {t.confirmEmail.checkEmail.resendButton}
            </button>
          </form>
        )
      }

      <a href="/auth/signin" class="text-primary text-sm hover:underline">
        {content.linkText}
      </a>
    </div>
  </div>
</Layout>
