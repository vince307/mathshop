---
import Layout from "@/layouts/Layout.astro";
import AuthShell from "@/components/auth/AuthShell.astro";
import ResetPasswordForm from "@/components/auth/ResetPasswordForm";
import { AuthArrowLeftIcon, AuthLockFilledIcon } from "@/components/icons/authIcons";
import { HERO_RESET } from "@/data/marketing-art";
import { t } from "@/i18n";

/**
 * Password-reset request screen (mockup `04-password-reset`). Reachable while
 * signed in on purpose — it is NOT in middleware's AUTH_FORM_PAGES — so a parent
 * who is logged in but wants a new password has a path, without building a
 * separate change-password surface.
 *
 * `?sent=1` renders the notice INSTEAD of the form. The notice is conditional
 * wording ("Jeśli konto z tym adresem istnieje…") and renders identically for
 * registered and unknown addresses — the page must never reveal which is which.
 * The card hero and heading sit ABOVE that branch, so the screen looks like
 * itself in both states.
 *
 * The marketing column leads with this screen's own promise — "Bezpieczny
 * dostęp" / "Panel rodzica" over `resetTagline` — because that is what the
 * mockup's left panel says, not screen 01's "Zaloguj się".
 */
const sent = Astro.url.searchParams.get("sent") === "1";
const error = Astro.url.searchParams.get("error");
---

<Layout title={t.auth.reset.title}>
  <AuthShell heading={t.marketing.resetHeading} accent={t.marketing.parentPanel} tagline={t.marketing.resetTagline}>
    <div class="bg-card text-card-foreground border-border shadow-mm-card rounded-3xl border p-6 sm:p-8">
      <div class="flex flex-col items-center text-center">
        {
          /* The envelope-and-padlock hero. MUST stay on this `bg-card` surface —
            its white card is keyed out of the PNG, so on the page background the
            hole would read as a pale rectangle (`slice-map.md`). */
        }
        <img
          src={HERO_RESET}
          alt=""
          aria-hidden="true"
          width="402"
          height="264"
          class="h-auto w-60 max-w-full sm:w-72"
        />
        <h1 class="text-foreground mt-4 text-3xl font-extrabold">{t.auth.reset.heading}</h1>
        <p class="text-muted-foreground mt-2 text-sm">{t.auth.reset.description}</p>
      </div>

      {
        sent ? (
          <p class="border-success/30 bg-success/10 text-success-strong mt-6 rounded-xl border px-3 py-2 text-sm">
            {t.auth.reset.sentNotice}
          </p>
        ) : (
          <div class="mt-6">
            <ResetPasswordForm serverError={error} client:load />
          </div>
        )
      }

      <div class="my-5 flex items-center gap-3">
        <span class="bg-border h-px flex-1"></span>
        <span class="text-muted-foreground text-xs">{t.marketing.or}</span>
        <span class="bg-border h-px flex-1"></span>
      </div>

      <a
        href="/auth/signin"
        class="text-primary flex items-center justify-center gap-2 text-sm font-medium hover:underline"
      >
        <AuthArrowLeftIcon className="size-5" />
        {t.auth.reset.backToSignin}
      </a>

      {/* The mockup's closing reassurance, inside the card. */}
      <p class="text-muted-foreground mt-5 flex items-center justify-center gap-2 text-xs">
        <AuthLockFilledIcon className="size-4" />
        {t.auth.reset.protectHint}
      </p>
    </div>
  </AuthShell>
</Layout>
