---
import Layout from "@/layouts/Layout.astro";
import AuthShell from "@/components/auth/AuthShell.astro";
import ResetPasswordForm from "@/components/auth/ResetPasswordForm";
import { KeyRound, ArrowLeft } from "lucide-react";
import { t } from "@/i18n";

/**
 * Password-reset request screen (mockup `04-password-reset`). Reachable while
 * signed in on purpose — it is NOT in middleware's AUTH_FORM_PAGES — so a parent
 * who is logged in but wants a new password has a path, without building a
 * separate change-password surface.
 *
 * `?sent=1` renders the notice INSTEAD of the form. The notice is conditional
 * wording ("Jeśli konto z tym adresem istnieje…") and renders identically for
 * registered and unknown addresses — the page must never reveal which is which.
 */
const sent = Astro.url.searchParams.get("sent") === "1";
const error = Astro.url.searchParams.get("error");
---

<Layout title={t.auth.reset.title}>
  <AuthShell heading={t.marketing.parentPanel} accent={t.auth.reset.heading}>
    <div class="bg-card text-card-foreground border-border rounded-2xl border p-8 shadow-sm">
      <div class="flex flex-col items-center text-center">
        <span class="bg-primary/10 text-primary inline-flex size-14 items-center justify-center rounded-2xl">
          <KeyRound className="size-7" />
        </span>
        <h1 class="text-foreground mt-4 text-2xl font-bold">{t.auth.reset.heading}</h1>
        <p class="text-muted-foreground mt-1 text-sm">{t.auth.reset.description}</p>
      </div>

      {
        sent ? (
          <p class="mt-6 rounded-lg border border-green-600/30 bg-green-50 px-3 py-2 text-sm text-green-700">
            {t.auth.reset.sentNotice}
          </p>
        ) : (
          <div class="mt-6">
            <ResetPasswordForm serverError={error} client:load />
          </div>
        )
      }

      <div class="my-5 flex items-center gap-3">
        <span class="bg-border h-px flex-1"></span>
        <span class="text-muted-foreground text-xs">{t.marketing.or}</span>
        <span class="bg-border h-px flex-1"></span>
      </div>

      <a
        href="/auth/signin"
        class="text-primary flex items-center justify-center gap-2 text-sm font-medium hover:underline"
      >
        <ArrowLeft className="size-4" />
        {t.auth.reset.backToSignin}
      </a>
    </div>
  </AuthShell>
</Layout>
