---
import Layout from "@/layouts/Layout.astro";
import AuthShell from "@/components/auth/AuthShell.astro";
import SignInForm from "@/components/auth/SignInForm";
import { buttonVariants } from "@/components/ui/button";
import { UserRound, UserPlus } from "lucide-react";
import { t } from "@/i18n";

const error = Astro.url.searchParams.get("error");
---

<Layout title={t.auth.signin.title}>
  <AuthShell heading={t.marketing.parentPanel} accent={t.auth.signin.heading}>
    <div class="bg-card text-card-foreground border-border rounded-2xl border p-8 shadow-sm">
      <div class="flex flex-col items-center text-center">
        <span class="bg-primary/10 text-primary inline-flex size-14 items-center justify-center rounded-2xl">
          <UserRound className="size-7" />
        </span>
        <h1 class="text-foreground mt-4 text-2xl font-bold">{t.marketing.parentPanel}</h1>
        <p class="text-muted-foreground mt-1 text-sm">{t.auth.signin.heading}</p>
      </div>

      <div class="mt-6">
        <SignInForm serverError={error} client:load />
      </div>

      <div class="my-5 flex items-center gap-3">
        <span class="bg-border h-px flex-1"></span>
        <span class="text-muted-foreground text-xs">{t.marketing.or}</span>
        <span class="bg-border h-px flex-1"></span>
      </div>

      <a
        href="/auth/signup"
        class:list={buttonVariants({ variant: "outline", size: "lg", className: "w-full font-medium" })}
      >
        <UserPlus className="size-4" />
        {t.auth.signin.signupLink}
      </a>
    </div>
  </AuthShell>
</Layout>
