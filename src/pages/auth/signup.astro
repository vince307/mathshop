---
import Layout from "@/layouts/Layout.astro";
import SignUpForm from "@/components/auth/SignUpForm";
import { t } from "@/i18n";

const error = Astro.url.searchParams.get("error");
---

<Layout title={t.auth.signup.title}>
  <div class="bg-background flex min-h-screen items-center justify-center p-4">
    <div class="bg-card text-card-foreground border-border w-full max-w-sm rounded-2xl border p-8 shadow-sm">
      <h1 class="text-foreground mb-6 text-center text-2xl font-bold">
        {t.auth.signup.heading}
      </h1>
      <SignUpForm serverError={error} client:load />
      <p class="text-muted-foreground mt-4 text-center text-sm">
        {t.auth.signup.hasAccount}
        <a href="/auth/signin" class="text-primary hover:underline">{t.auth.signup.signinLink}</a>
      </p>
    </div>
  </div>
</Layout>
