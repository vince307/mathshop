---
import { FEATURE_ICONS } from "@/data/marketing-art";
import { t } from "@/i18n";

/**
 * The three value props shown to signed-out visitors (auth-v2 mockup `01`).
 *
 * **Card chrome is breakpoint-dependent, and that is faithful, not a compromise.**
 * The web mockup sets these blocks directly on the page background; the mobile
 * mockup of the same screen keeps them in white cards, because at 390 px three
 * borderless columns run into each other. So the chrome is dropped at `lg` and
 * kept below it.
 *
 * Icons come from `FEATURE_ICONS`, index-aligned with `t.marketing.features` and
 * pinned to the same length by `tests/auth-art.test.ts` — a parallel list with no
 * sync is what once let the marketing panel advertise four worlds while the app
 * shipped six. They are `<img>` because they are Group A art: fixed brand colours
 * the caller never recolours (`src/data/marketing-art.ts`).
 *
 * The grid's column count belongs to the caller, not here — the auth panel runs
 * three columns at every width, the landing page stacks to one below `sm`.
 *
 * The icon box is sized straight to the mockup. It used to be a step larger,
 * because the RETIRED atomic-pack SVGs did not fill their 64-unit viewBox and a
 * mockup-sized box rendered them visibly small; the auth-v2 extraction's glyphs
 * fill theirs, so the compensation is gone.
 */
interface Props {
  /** Grid columns and spacing. The caller owns layout; this owns the blocks. */
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["grid gap-2 sm:gap-4", className]}>
  {
    t.marketing.features.map((feature, i) => (
      <div class="bg-card border-border rounded-2xl border p-3 text-center shadow-sm sm:p-4 lg:border-0 lg:bg-transparent lg:p-0 lg:shadow-none">
        <img
          src={FEATURE_ICONS[i]}
          alt=""
          aria-hidden="true"
          class="mx-auto size-11 sm:size-14 lg:size-16"
          width="64"
          height="64"
        />
        <p class="text-foreground mt-2 text-xs font-bold sm:mt-3 sm:text-base">{feature.title}</p>
        <p class="text-muted-foreground mt-1 text-sm leading-snug">{feature.description}</p>
      </div>
    ))
  }
</div>
