---
import MarketingPageShell from "@/components/marketing/MarketingPageShell.astro";
import "@/styles/legal.css";

interface SummaryItem {
  icon: string;
  color: string;
  title: string;
  body: string;
}

interface Props {
  title: string;
  description: string;
  kicker: string;
  heading: string;
  intro: string;
  meta: readonly string[];
  summaryHeading: string;
  summary: readonly SummaryItem[];
}

const { title, description, kicker, heading, intro, meta, summaryHeading, summary } = Astro.props;
---

<MarketingPageShell {title} {description} active="">
  <div class="legal-page-content">
    <section class="legal-hero">
      <div class="legal-hero-copy">
        <span class="legal-kicker">{kicker}</span>
        <h1>{heading}</h1>
        <p>{intro}</p>
        <div class="legal-meta" role="list">
          {meta.map((item) => <span role="listitem">{item}</span>)}
        </div>
      </div>

      <div class="legal-hero-visual" aria-hidden="true">
        <img class="legal-coins" src="/parents/cutouts/hero-coins.png" alt="" />
        <img class="legal-shield" src="/parents/cutouts/bottom-security-shield.png" alt="" />
        <span class="legal-star legal-star-one"></span>
        <span class="legal-star legal-star-two"></span>
        <aside class="legal-summary-card">
          <h2>{summaryHeading}</h2>
          <div class="legal-mini-list">
            {
              summary.map((item) => (
                <div class="legal-mini-row">
                  <span class="legal-mini-icon" style={`--legal-icon-color:${item.color}`}>
                    {item.icon}
                  </span>
                  <div>
                    <strong>{item.title}</strong>
                    <small>{item.body}</small>
                  </div>
                </div>
              ))
            }
          </div>
        </aside>
      </div>
    </section>

    <slot />
  </div>
</MarketingPageShell>
