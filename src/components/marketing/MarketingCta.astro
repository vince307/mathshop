---
import { ArrowRight, UserRoundPlus } from "lucide-react";
import { t } from "@/i18n";

interface Props {
  heading: string;
  description: string;
  showWorldsLink?: boolean;
}

const { heading, description, showWorldsLink = true } = Astro.props;
const { user } = Astro.locals;
---

<section
  class="relative overflow-hidden rounded-[2rem] bg-[#0a2a67] px-6 py-10 text-center text-white shadow-[0_24px_60px_rgba(16,70,145,0.2)] sm:px-10 lg:flex lg:items-center lg:justify-between lg:gap-10 lg:px-14 lg:text-left"
>
  <div class="absolute -top-24 -right-20 size-64 rounded-full bg-blue-400/25 blur-2xl" aria-hidden="true"></div>
  <div class="relative max-w-2xl">
    <h2 class="text-3xl font-extrabold tracking-tight">{heading}</h2>
    <p class="mt-3 text-base leading-relaxed text-blue-100">{description}</p>
  </div>
  <div class="relative mt-7 flex shrink-0 flex-col justify-center gap-3 sm:flex-row lg:mt-0">
    <a
      href={user ? "/app" : "/auth/signup"}
      class="text-primary inline-flex min-h-14 items-center justify-center gap-2 rounded-2xl bg-white px-6 font-extrabold shadow-lg transition hover:-translate-y-0.5"
    >
      <UserRoundPlus className="size-5" aria-hidden="true" />
      {user ? t.nav.app : t.marketingPages.common.startFree}
    </a>
    {
      showWorldsLink && (
        <a
          href="/swiaty"
          class="inline-flex min-h-14 items-center justify-center gap-2 rounded-2xl border border-white/35 px-6 font-extrabold text-white transition hover:bg-white/10"
        >
          {t.marketingPages.common.seeWorlds}
          <ArrowRight className="size-5" aria-hidden="true" />
        </a>
      )
    }
  </div>
</section>
