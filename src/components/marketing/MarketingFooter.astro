---
import { t } from "@/i18n";

const footer = t.marketingPages.footer;
const copyright = footer.copyright.replace("{year}", String(new Date().getFullYear()));
---

<footer class="mm-footer" aria-labelledby="marketing-footer-heading">
  <div class="mm-footer-shell">
    <section class="mm-footer-cta" aria-labelledby="marketing-footer-heading">
      <div class="mm-footer-cta-copy">
        <span class="mm-footer-kicker">{footer.kicker}</span>
        <h2 id="marketing-footer-heading">{footer.heading}</h2>
        <p>{footer.description}</p>
        <div class="mm-footer-actions" role="group" aria-label={footer.actionsLabel}>
          <a class="mm-footer-btn mm-footer-btn-primary" href="/auth/signup">
            <img src="/footer/icons/cta-plus.svg" alt="" aria-hidden="true" />
            {footer.startFree}
          </a>
          <a class="mm-footer-btn mm-footer-btn-secondary" href="/swiaty">
            <img src="/footer/icons/cta-play-circle.svg" alt="" aria-hidden="true" />
            {footer.seeWorlds}
          </a>
        </div>
      </div>

      <div class="mm-footer-visual" aria-hidden="true">
        <img
          class="mm-footer-cluster"
          src="/footer/illustrations/footer-cta-illustration-cluster.png"
          alt=""
          width="520"
          height="260"
        />
        <img class="mm-footer-stars" src="/footer/decor/footer-stars.svg" alt="" />
        <img class="mm-footer-path" src="/footer/decor/footer-dashed-path.svg" alt="" />
      </div>
    </section>

    <section class="mm-footer-main" aria-label={footer.sectionLabel}>
      <div class="mm-footer-brand">
        <a class="mm-footer-logo" href="/" aria-label={t.welcome.navigation.homeLabel}>
          <img src="/footer/illustrations/footer-brand-mark.png" alt="" aria-hidden="true" width="90" height="78" />
          <span>
            <strong><span>{t.welcome.brandFirst}</span><em>{t.welcome.brandSecond}</em></strong>
            <small>{footer.tagline}</small>
          </span>
        </a>
        <p>{footer.brandDescription}</p>
        <div class="mm-footer-trust-row" role="list" aria-label={footer.trustLabel}>
          {footer.trustChips.map((chip) => <span role="listitem">{chip}</span>)}
        </div>
      </div>

      <nav class="mm-footer-nav" aria-label={footer.navigationLabel}>
        {
          footer.columns.map((column) => (
            <div class="mm-footer-column">
              <h3>{column.title}</h3>
              {column.links.map((link) => (
                <a href={link.href}>{link.label}</a>
              ))}
            </div>
          ))
        }
      </nav>

      <aside class="mm-footer-safety" aria-label={footer.safetyLabel}>
        <img src="/footer/icons/footer-lock-badge.svg" alt="" aria-hidden="true" width="54" height="54" />
        <div>
          <h3>{footer.safetyHeading}</h3>
          <p>{footer.safetyDescription}</p>
        </div>
      </aside>
    </section>

    <section class="mm-footer-bottom" aria-label={footer.legalLabel}>
      <p>{copyright}</p>
      <div>
        {footer.legalLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      </div>
    </section>
  </div>
</footer>

<style>
  .mm-footer,
  .mm-footer * {
    box-sizing: border-box;
  }

  .mm-footer {
    position: relative;
    color: #06164d;
    padding: 32px;
    background:
      radial-gradient(circle at 8% 18%, rgb(91 177 255 / 18%), transparent 25%),
      radial-gradient(circle at 92% 8%, rgb(255 195 73 / 18%), transparent 22%),
      linear-gradient(180deg, #f6fbff 0%, #eef7ff 100%);
  }

  .mm-footer a {
    color: inherit;
    text-decoration: none;
  }

  .mm-footer-shell {
    width: min(1440px, 100%);
    margin: 0 auto;
    overflow: hidden;
    border: 1px solid rgb(164 198 241 / 72%);
    border-radius: 32px;
    background: linear-gradient(180deg, rgb(255 255 255 / 92%) 0%, rgb(244 250 255 / 96%) 100%);
    box-shadow: 0 24px 64px rgb(39 90 154 / 14%);
  }

  .mm-footer-cta {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 440px;
    gap: 32px;
    min-height: 246px;
    padding: 42px 54px;
    overflow: hidden;
    background:
      linear-gradient(102deg, rgb(231 244 255 / 92%), rgb(255 255 255 / 90%) 54%, rgb(234 247 240 / 92%)),
      repeating-linear-gradient(135deg, rgb(9 103 246 / 6%) 0 1px, transparent 1px 18px);
  }

  .mm-footer-kicker {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    min-height: 34px;
    padding: 7px 13px;
    border: 1px solid rgb(44 128 255 / 22%);
    border-radius: 999px;
    background: rgb(255 255 255 / 72%);
    color: #0a64e8;
    font-size: 14px;
    font-weight: 800;
  }

  .mm-footer-cta h2 {
    max-width: 720px;
    margin: 16px 0 12px;
    font-size: clamp(34px, 4vw, 56px);
    line-height: 0.98;
    font-weight: 800;
    letter-spacing: -0.025em;
  }

  .mm-footer-cta-copy > p {
    max-width: 660px;
    margin: 0;
    color: #40588d;
    font-size: 21px;
    line-height: 1.42;
  }

  .mm-footer-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 26px;
  }

  .mm-footer-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 56px;
    padding: 0 24px;
    border-radius: 13px;
    font-size: 18px;
    font-weight: 850;
    white-space: nowrap;
    transition:
      transform 180ms ease,
      box-shadow 180ms ease,
      background-color 180ms ease;
  }

  .mm-footer-btn img {
    width: 28px;
    height: 28px;
  }

  .mm-footer-btn-primary {
    color: #fff !important;
    background: linear-gradient(180deg, #1075ff, #005bea);
    box-shadow: 0 10px 24px rgb(0 91 234 / 25%);
  }

  .mm-footer-btn-secondary {
    color: #06164d;
    border: 2px solid rgb(9 103 246 / 72%);
    background: rgb(255 255 255 / 82%);
  }

  .mm-footer-btn:hover {
    transform: translateY(-2px);
  }

  .mm-footer-btn-primary:hover {
    box-shadow: 0 14px 30px rgb(0 91 234 / 30%);
  }

  .mm-footer-btn-secondary:hover {
    background: #fff;
  }

  .mm-footer-visual {
    position: relative;
    min-height: 196px;
  }

  .mm-footer-cluster {
    position: absolute;
    right: 18px;
    bottom: -10px;
    width: min(420px, 100%);
    height: auto;
    filter: drop-shadow(0 18px 20px rgb(36 77 128 / 16%));
  }

  .mm-footer-stars {
    position: absolute;
    top: 72px;
    right: 154px;
    width: 72px;
  }

  .mm-footer-path {
    position: absolute;
    top: 24px;
    right: 196px;
    width: 150px;
  }

  .mm-footer-main {
    display: grid;
    grid-template-columns: minmax(260px, 1.18fr) minmax(500px, 1.65fr) minmax(250px, 0.8fr);
    gap: 34px;
    padding: 36px 54px 30px;
    background: rgb(255 255 255 / 74%);
  }

  .mm-footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 15px;
  }

  .mm-footer-logo > img {
    width: 72px;
    height: auto;
  }

  .mm-footer-logo strong {
    display: block;
    font-size: 34px;
    line-height: 0.95;
    font-weight: 850;
    letter-spacing: -0.03em;
  }

  .mm-footer-logo strong span {
    color: #0a6bf5;
  }

  .mm-footer-logo strong em {
    color: #118328;
    font-style: normal;
  }

  .mm-footer-logo small {
    display: block;
    margin-top: 7px;
    color: #5b6f9d;
    font-size: 14px;
    font-weight: 650;
  }

  .mm-footer-brand > p,
  .mm-footer-safety p {
    margin: 20px 0 0;
    color: #465f93;
    font-size: 16px;
    line-height: 1.55;
  }

  .mm-footer-trust-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
  }

  .mm-footer-trust-row span {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 6px 11px;
    border: 1px solid #dbeaff;
    border-radius: 999px;
    background: #f7fbff;
    color: #0a2a67;
    font-size: 13px;
    font-weight: 800;
  }

  .mm-footer-nav {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .mm-footer-column h3,
  .mm-footer-safety h3 {
    margin: 0 0 14px;
    color: #06164d;
    font-size: 17px;
    line-height: 1.2;
    font-weight: 800;
  }

  .mm-footer-column a {
    display: block;
    width: fit-content;
    margin: 12px 0;
    color: #40588d;
    font-size: 15px;
    font-weight: 700;
  }

  .mm-footer-column a:hover,
  .mm-footer-column a:focus-visible,
  .mm-footer-bottom a:hover,
  .mm-footer-bottom a:focus-visible {
    color: #0967f6;
  }

  .mm-footer-safety {
    align-self: start;
    display: grid;
    grid-template-columns: 54px minmax(0, 1fr);
    gap: 14px;
    padding: 18px;
    border: 1px solid #dceaff;
    border-radius: 20px;
    background: linear-gradient(180deg, #fff, #f2f8ff);
    box-shadow: 0 14px 34px rgb(40 86 145 / 10%);
  }

  .mm-footer-safety > img {
    width: 54px;
    height: 54px;
  }

  .mm-footer-safety p {
    margin-top: 0;
    font-size: 14px;
  }

  .mm-footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 19px 54px 24px;
    border-top: 1px solid rgb(188 212 244 / 76%);
    color: #6075a2;
    font-size: 14px;
    font-weight: 650;
  }

  .mm-footer-bottom p {
    margin: 0;
  }

  .mm-footer-bottom div {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
  }

  @media (max-width: 900px) {
    .mm-footer {
      padding: 16px;
    }

    .mm-footer-shell {
      border-radius: 24px;
    }

    .mm-footer-cta {
      grid-template-columns: 1fr;
      min-height: 0;
      padding: 30px 24px 22px;
    }

    .mm-footer-cta h2 {
      font-size: 34px;
      line-height: 1.05;
    }

    .mm-footer-cta-copy > p {
      font-size: 17px;
    }

    .mm-footer-actions {
      display: grid;
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .mm-footer-btn {
      width: 100%;
      min-height: 54px;
      font-size: 16px;
    }

    .mm-footer-visual {
      min-height: 172px;
    }

    .mm-footer-cluster {
      right: 0;
      bottom: -8px;
      width: 310px;
    }

    .mm-footer-main {
      grid-template-columns: 1fr;
      gap: 28px;
      padding: 28px 24px 24px;
    }

    .mm-footer-nav {
      grid-template-columns: 1fr 1fr;
      gap: 18px 22px;
    }

    .mm-footer-bottom {
      align-items: flex-start;
      flex-direction: column;
      padding: 19px 24px 24px;
    }
  }

  @media (max-width: 520px) {
    .mm-footer-cta h2 {
      font-size: 30px;
    }

    .mm-footer-logo > img {
      width: 64px;
    }

    .mm-footer-logo strong {
      font-size: 29px;
    }

    .mm-footer-logo small {
      max-width: 190px;
      font-size: 12px;
    }

    .mm-footer-nav {
      grid-template-columns: 1fr;
    }

    .mm-footer-column a {
      margin: 10px 0;
    }

    .mm-footer-safety {
      grid-template-columns: 48px minmax(0, 1fr);
      padding: 16px;
      border-radius: 18px;
    }

    .mm-footer-safety > img {
      width: 48px;
      height: 48px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mm-footer-btn {
      transition: none;
    }
  }
</style>
