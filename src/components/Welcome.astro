---
import { Store } from "lucide-react";
import { t } from "@/i18n";
import MarketingHeader from "@/components/marketing/MarketingHeader.astro";
import WorldCarousel from "@/components/marketing/WorldCarousel.astro";

const { user } = Astro.locals;
const featureIcons = [
  "/landing/cutouts/feature-age-6-9-icon.png",
  "/landing/cutouts/feature-no-ads-icon.png",
  "/landing/cutouts/feature-parent-panel-icon.png",
  "/landing/cutouts/feature-worlds-icon.png",
] as const;
---

<main class="landing-page relative min-h-screen overflow-hidden bg-[#f7fbff]">
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <img
      src="/landing/cutouts/decor-top-dotted-path.png"
      alt=""
      class="absolute top-[100px] left-[calc(50%_-_313px)] hidden w-[199px] opacity-55 lg:block"
    />
    <img
      src="/landing/cutouts/decor-top-chart.png"
      alt=""
      class="absolute top-[112px] left-[calc(50%_-_63px)] hidden w-[100px] opacity-45 xl:block"
    />
    <img
      src="/landing/cutouts/decor-top-right-receipt-coins.png"
      alt=""
      class="absolute top-[118px] right-0 hidden w-[140px] opacity-35 xl:block"
    />
    <img
      src="/landing/cutouts/decor-left-plant.png"
      alt=""
      class="absolute top-[618px] left-[max(0px,calc(50%_-_740px))] hidden w-20 opacity-65 xl:block"
    />
    <img
      src="/landing/cutouts/decor-bottom-left-coins.png"
      alt=""
      class="absolute top-[885px] left-0 hidden w-32 opacity-95 xl:block"
    />
    <img
      src="/landing/cutouts/decor-bottom-chart-shield.png"
      alt=""
      class="absolute top-[930px] left-[max(150px,calc(50%_-_588px))] hidden w-[180px] opacity-55 xl:block"
    />
    <img
      src="/landing/cutouts/decor-right-checklist.png"
      alt=""
      class="absolute top-[720px] right-0 hidden w-[150px] opacity-55 xl:block"
    />
    <img
      src="/landing/cutouts/decor-bottom-right-plant.png"
      alt=""
      class="absolute top-[890px] right-0 hidden w-[125px] opacity-65 xl:block"
    />
    <div class="absolute top-8 left-1/2 size-[44rem] -translate-x-1/2 rounded-full bg-blue-100/35 blur-3xl"></div>
    <div class="absolute right-0 bottom-0 size-80 rounded-full bg-emerald-100/35 blur-3xl"></div>
  </div>

  <div class="relative mx-auto w-full max-w-[1536px] px-5 py-5 sm:px-8 lg:pt-8">
    <MarketingHeader active="/" />

    <section
      id="jak-to-dziala"
      class="grid items-center gap-10 pt-12 pb-8 lg:grid-cols-[0.88fr_1.12fr] lg:px-10 lg:pt-2 lg:pb-0 xl:grid-cols-[minmax(0,580px)_minmax(0,773px)] xl:justify-between xl:gap-0"
    >
      <div class="relative z-10 max-w-[620px] text-center lg:text-left">
        <h1
          class="text-[2.55rem] leading-[1.08] font-extrabold tracking-[-0.035em] text-[#07174f] sm:text-5xl lg:text-[clamp(2.5rem,3.25vw,3.15rem)]"
        >
          {t.welcome.hero.lineOne}<br />
          {t.welcome.hero.lineTwo}
          <span class="text-primary">{t.welcome.hero.accent}</span>
        </h1>
        <p
          class="text-muted-foreground mx-auto mt-6 max-w-[585px] text-lg leading-relaxed sm:text-xl lg:mx-0 xl:text-[1.35rem]"
        >
          {t.welcome.hero.description}
        </p>

        <div class="mt-7 flex flex-col justify-center gap-3 sm:flex-row lg:justify-start">
          <a
            href={user ? "/app" : "/auth/signup"}
            class="bg-primary text-primary-foreground inline-flex min-h-14 items-center justify-center gap-3 rounded-2xl px-7 text-base font-extrabold shadow-lg shadow-blue-200 transition hover:-translate-y-0.5 hover:shadow-xl"
          >
            {
              user ? (
                <Store className="size-6 shrink-0" aria-hidden="true" />
              ) : (
                <img src="/landing/icons/cta-user-plus.svg" alt="" aria-hidden="true" class="size-8 shrink-0" />
              )
            }
            {user ? t.nav.app : t.welcome.cta.startFree}
          </a>
          <a
            href="#swiaty"
            class="border-primary text-primary inline-flex min-h-14 items-center justify-center gap-3 rounded-2xl border-2 bg-white/80 px-7 text-base font-extrabold shadow-sm transition hover:-translate-y-0.5 hover:bg-white"
          >
            <img src="/landing/icons/cta-play-circle.svg" alt="" aria-hidden="true" class="size-8 shrink-0" />
            {t.welcome.cta.seeWorlds}
          </a>
        </div>
      </div>

      <div class="relative mx-auto w-full max-w-[773px]" role="img" aria-label={t.welcome.hero.previewLabel}>
        <svg
          class="pointer-events-none absolute inset-0 h-full w-full drop-shadow-[0_18px_25px_rgba(49,102,166,0.16)]"
          viewBox="0 0 773 492"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M199 1C177 1 161 15 158 38L125 365C122 392 135 412 162 417L616 466C653 470 678 457 684 427L716 59C720 31 704 16 671 12L199 1Z"
            fill="white"
            stroke="#dce9f8"
            stroke-width="2"></path>
        </svg>
        <img
          src="/landing/cutouts/hero-world-dashboard-composite.png"
          alt=""
          aria-hidden="true"
          class="relative z-10 w-full drop-shadow-[0_28px_35px_rgba(49,102,166,0.22)]"
        />
      </div>
    </section>

    <section
      id="dla-rodzica"
      class="relative z-10 mx-auto mt-4 grid max-w-[1280px] overflow-hidden rounded-[1.75rem] border border-white bg-white/90 shadow-[0_16px_45px_rgba(39,95,155,0.14)] sm:grid-cols-2 lg:-mt-3 lg:grid-cols-4"
    >
      {
        t.welcome.features.map((feature, index) => {
          return (
            <article class="relative flex items-center gap-4 px-5 py-5 lg:min-h-[120px] lg:px-7">
              {index > 0 && (
                <span class="bg-border absolute top-1/2 left-0 hidden h-16 w-px -translate-y-1/2 lg:block" />
              )}
              <span class:list={["flex size-[72px] shrink-0 items-center justify-center rounded-full bg-transparent"]}>
                <img src={featureIcons[index]} alt="" aria-hidden="true" class="size-[72px] object-contain" />
              </span>
              <div>
                <h2 class="font-extrabold text-[#07174f]">{feature.title}</h2>
                <p class="text-muted-foreground mt-1 text-sm leading-snug">{feature.description}</p>
              </div>
            </article>
          );
        })
      }
    </section>

    <section
      id="swiaty"
      class="relative z-10 mx-auto grid max-w-[1276px] items-center gap-8 pt-10 pb-8 lg:grid-cols-[250px_minmax(0,1fr)] lg:pt-[26px] lg:pb-0 xl:grid-cols-[270px_minmax(0,1fr)] xl:pr-[52px]"
    >
      <div class="text-center lg:self-start lg:pt-6 lg:text-left">
        <h2 class="text-2xl leading-tight font-extrabold text-[#07174f]">{t.welcome.worlds.heading}</h2>
        <p class="text-muted-foreground mt-3 text-sm leading-relaxed">{t.welcome.worlds.description}</p>
      </div>

      <WorldCarousel />
    </section>
  </div>
</main>

<style>
  .landing-page {
    background-image:
      radial-gradient(circle at 62% 28%, rgb(222 239 255 / 0.76), transparent 34rem),
      linear-gradient(145deg, #fbfdff 0%, #f4f9ff 58%, #f8fcff 100%);
  }

  @media (prefers-reduced-motion: no-preference) {
    .landing-page a,
    .landing-page article {
      transition-duration: 180ms;
    }
  }
</style>
