---
import { ShoppingCart, ShieldCheck, Globe, TrendingUp, LogIn, UserPlus, ArrowRight } from "lucide-react";
import { buttonVariants } from "@/components/ui/button";
import { WORLDS } from "@/data/worlds";
import { t } from "@/i18n";

/**
 * Signed-out landing (`/`). No mockup exists for this route, so it is built from
 * the product's own auth-mockup vocabulary — brand row, hero, world cards, the
 * three feature cards and the security footer — rather than the starter's
 * developer-facing scaffold copy. Copy comes from `t.marketing`, shared with the
 * auth split view, so the two surfaces stay in step; the world cards map `WORLDS`
 * itself, so this page cannot advertise a different set than the app ships.
 * `grid-cols-2` absorbs six as three rows and needs no breakpoint of its own.
 */
const { user } = Astro.locals;
const featureIcons = [ShieldCheck, Globe, TrendingUp];
---

<div class="bg-background min-h-screen w-full px-4 py-6 sm:px-6 lg:px-10">
  <div class="mx-auto w-full max-w-6xl">
    {/* Header: brand + the one action that fits the visitor's state */}
    <header class="flex items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <span
          class="bg-primary text-primary-foreground inline-flex size-10 items-center justify-center rounded-xl shadow-sm"
        >
          <ShoppingCart className="size-5" />
        </span>
        <div>
          <p class="text-foreground text-lg leading-none font-extrabold">{t.brand}</p>
          <p class="text-muted-foreground mt-1 text-xs">{t.marketing.brandTagline}</p>
        </div>
      </div>

      {
        user ? (
          <a href="/app" class:list={buttonVariants({ variant: "default" })}>
            {t.nav.app}
            <ArrowRight className="size-4" />
          </a>
        ) : (
          <div class="flex items-center gap-2">
            {/* Wrapper carries the breakpoint: `hidden` on the anchor itself would
                collide with the button's own `inline-flex` display utility. */}
            <div class="hidden sm:block">
              <a href="/auth/signin" class:list={buttonVariants({ variant: "ghost" })}>
                {t.nav.signIn}
              </a>
            </div>
            <a href="/auth/signup" class:list={buttonVariants({ variant: "default" })}>
              <UserPlus className="size-4" />
              {t.nav.signUp}
            </a>
          </div>
        )
      }
    </header>

    {/* Hero */}
    <div class="relative mt-12 grid items-center gap-10 lg:mt-20 lg:grid-cols-[1.1fr_0.9fr] xl:gap-16">
      <div class="text-center lg:text-left">
        <h1 class="text-foreground text-4xl font-extrabold tracking-tight sm:text-5xl xl:text-6xl">
          {t.brand}
        </h1>
        <p class="text-primary mt-2 text-2xl font-bold sm:text-3xl">{t.marketing.heroTagline}</p>
        <p class="text-muted-foreground mt-4 text-base sm:text-lg">{t.welcome.heroSubtitle}</p>

        {
          !user && (
            <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:justify-center lg:justify-start">
              <a href="/auth/signup" class:list={buttonVariants({ variant: "default", size: "lg" })}>
                <UserPlus className="size-4" />
                {t.nav.signUp}
              </a>
              <a href="/auth/signin" class:list={buttonVariants({ variant: "outline", size: "lg" })}>
                <LogIn className="size-4" />
                {t.nav.signIn}
              </a>
            </div>
          )
        }
      </div>

      {/* World cards — what the child actually runs */}
      <div class="grid grid-cols-2 gap-3 sm:gap-4">
        {
          WORLDS.map((world) => (
            <div class="bg-card border-border overflow-hidden rounded-2xl border shadow-sm">
              <img src={world.image} alt={world.name} loading="lazy" class="aspect-square w-full object-cover" />
              <p class="text-foreground px-2 py-2.5 text-center text-sm font-semibold">{world.name}</p>
            </div>
          ))
        }
      </div>
    </div>

    {/* Feature cards */}
    <div class="mt-14 grid gap-4 sm:grid-cols-3 lg:mt-20">
      {
        t.marketing.features.map((feature, i) => {
          const Icon = featureIcons[i];
          return (
            <div class="bg-card border-border rounded-2xl border p-5 shadow-sm">
              <span class="bg-primary/10 text-primary inline-flex size-11 items-center justify-center rounded-2xl">
                <Icon className="size-6" />
              </span>
              <p class="text-foreground mt-3 text-base font-bold">{feature.title}</p>
              <p class="text-muted-foreground mt-1 text-sm leading-snug">{feature.description}</p>
            </div>
          );
        })
      }
    </div>

    <div class="text-muted-foreground mt-10 flex items-center justify-center gap-2 pb-10 text-xs">
      <ShieldCheck className="text-primary size-4 shrink-0" />
      {t.marketing.security}
    </div>
  </div>
</div>
