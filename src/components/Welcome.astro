---
import Topbar from "@/components/Topbar.astro";
import { Lock, Layers, Code } from "lucide-react";
import { t } from "@/i18n";

const featureIcons = [Lock, Layers, Code];
---

<div class="bg-background relative min-h-screen w-full overflow-hidden">
  <div class="relative z-10 p-4 sm:p-8">
    <Topbar />

    <!-- Hero section -->
    <div class="mx-auto flex max-w-4xl flex-col items-center justify-center px-4 py-24 text-center sm:py-32 lg:py-40">
      <h1 class="text-foreground mb-6 text-5xl leading-tight font-bold sm:text-6xl lg:text-7xl">{t.brand}</h1>
      <p class="text-muted-foreground mb-10 max-w-2xl text-lg sm:text-xl">
        {t.welcome.heroSubtitle}
      </p>
      <div class="flex flex-col gap-4 sm:flex-row">
        <a
          href="/auth/signin"
          class="bg-primary text-primary-foreground hover:bg-primary/90 inline-flex items-center justify-center rounded-lg px-6 py-3 text-base font-medium transition-colors"
        >
          {t.nav.signIn}
        </a>
        <a
          href="/auth/signup"
          class="border-input text-foreground hover:bg-muted inline-flex items-center justify-center rounded-lg border px-6 py-3 text-base font-medium transition-colors"
        >
          {t.nav.signUp}
        </a>
      </div>
    </div>

    <!-- Feature cards -->
    <div class="mx-auto grid max-w-4xl grid-cols-1 gap-6 px-4 pb-24 sm:grid-cols-3">
      {
        t.welcome.features.map((feature, i) => {
          const Icon = featureIcons[i];
          return (
            <div class="bg-card border-border rounded-xl border p-6 shadow-sm">
              <Icon className="text-primary mb-4 size-6" />
              <h3 class="text-foreground mb-2 text-lg font-semibold">{feature.title}</h3>
              <p class="text-muted-foreground text-sm leading-relaxed">{feature.description}</p>
            </div>
          );
        })
      }
    </div>
  </div>
</div>
