---
import { WORLDS } from "@/data/worlds";
import { DECOR_COIN } from "@/data/marketing-art";
import { t } from "@/i18n";
import BrandRow from "@/components/marketing/BrandRow.astro";
import FeatureList from "@/components/marketing/FeatureList.astro";
import SecurityNote from "@/components/marketing/SecurityNote.astro";

/**
 * Two-column auth layout (mockup `01`): a left marketing panel — brand, hero,
 * three feature blocks, one card per world, decorative coins, security note —
 * beside a right-hand slot for the page's form card. Built once here; reused by
 * signup, password reset and update-password. Pure presentation, no behavior.
 *
 * Responsive: two columns on `lg+`; below that it stacks to a single column
 * (form first, then the marketing essentials). Marketing copy comes from
 * `t.marketing`; illustrations from committed `public/illustrations/` assets.
 *
 * Brand, features and the security note are shared components — `Welcome.astro`
 * renders the same three, so the signed-out product cannot present itself two
 * different ways. The **world strip below is deliberately NOT one of them**: this
 * panel runs it `hidden lg:grid grid-cols-3` while the landing page runs it
 * `grid-cols-2` at every width, and the two column counts answer to different
 * layouts. Sharing it would mean a component whose every dimension is a prop.
 *
 * The world strip maps `WORLDS` directly rather than a curated copy — a second
 * list is what let this panel advertise four worlds while the app shipped six.
 * Its column count is therefore a FUNCTION of that list: `grid-cols-3` holds six
 * as two clean rows. Growing `WORLDS` past six means revisiting this class, and
 * `e2e/marketing-worlds.spec.ts` is what makes that impossible to forget.
 */
interface Props {
  /** Hero heading, e.g. "Panel rodzica". */
  heading: string;
  /** Blue accent line under the hero, e.g. "Zaloguj się". */
  accent: string;
  /** Sub-tagline; defaults to the shared marketing tagline. */
  tagline?: string;
}

const { heading, accent, tagline = t.marketing.heroTagline } = Astro.props;
---

<div class="bg-background flex min-h-screen flex-col justify-center px-4 py-8 sm:px-6 lg:px-10">
  <div class="mx-auto w-full max-w-6xl">
    <BrandRow size="lg" class="mb-8 justify-center lg:justify-start" />

    <div class="grid items-center gap-6 lg:grid-cols-[1.1fr_0.9fr] lg:gap-10 xl:gap-16">
      {/* Marketing panel */}
      <section class="relative order-2 lg:order-1">
        {/* Decorative coin */}
        <img
          src={DECOR_COIN}
          alt=""
          aria-hidden="true"
          class="pointer-events-none absolute -top-8 right-4 hidden size-20 rotate-12 lg:block"
        />

        <div class="hidden lg:block">
          <p class="text-foreground text-5xl font-extrabold tracking-tight xl:text-6xl">{heading}</p>
          <p class="text-primary mt-2 text-3xl font-bold xl:text-4xl">{accent}</p>
          <p class="text-muted-foreground mt-4 text-lg">{tagline}</p>
        </div>

        <FeatureList class="mt-6 grid-cols-3 lg:mt-8" />

        {/* World cards (desktop only — mobile mockup omits them) */}
        <div class="mt-6 hidden grid-cols-3 gap-3 lg:grid">
          {
            WORLDS.map((world) => (
              <div class="bg-card border-border overflow-hidden rounded-2xl border shadow-sm">
                <img src={world.image} alt={world.name} loading="lazy" class="aspect-square w-full object-cover" />
                <p class="text-foreground px-2 py-2.5 text-center text-sm font-semibold">{world.name}</p>
              </div>
            ))
          }
        </div>

        <SecurityNote class="mt-6" />
      </section>

      {/* Form slot */}
      <div class="order-1 mx-auto w-full max-w-lg lg:order-2">
        <slot />
      </div>
    </div>
  </div>
</div>
