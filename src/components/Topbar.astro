---
import { t } from "@/i18n";

const { user } = Astro.locals;
---

<div
  class="bg-card border-border text-muted-foreground mb-4 flex items-center justify-between rounded-xl border px-4 py-2 text-sm shadow-sm"
>
  {
    user ? (
      <>
        <span>{user.email}</span>
        <div class="flex items-center gap-3">
          <a href="/app" class="text-primary transition-colors hover:underline">
            {t.nav.app}
          </a>
          <form method="POST" action="/api/auth/signout">
            <button type="submit" class="text-primary transition-colors hover:underline">
              {t.nav.signOut}
            </button>
          </form>
        </div>
      </>
    ) : (
      <>
        <span>{t.nav.notSignedIn}</span>
        <div class="flex gap-3">
          <a href="/auth/signin" class="text-primary transition-colors hover:underline">
            {t.nav.signIn}
          </a>
          <a href="/auth/signup" class="text-primary transition-colors hover:underline">
            {t.nav.signUp}
          </a>
        </div>
      </>
    )
  }
</div>
