---
import "@fontsource-variable/nunito";
import "../styles/global.css";
import Banner from "@/components/Banner.astro";
import { missingConfigs } from "@/lib/config-status";
import { t } from "@/i18n";

interface Props {
  title?: string;
}

const { title = t.brand } = Astro.props;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
    <script>
      // Back/forward-cache guard (S-10): a bfcache restore replays the page from
      // memory — after a logout that can resurface the previous account's rendered
      // data despite `no-store` (Safari notably ignores it for bfcache). Reload
      // through the server instead: it re-renders current state or bounces to signin.
      window.addEventListener("pageshow", (event) => {
        if (event.persisted) window.location.reload();
      });
    </script>
  </head>
  <body>
    {
      missingConfigs.map((cfg) => (
        <Banner variant="error">
          <strong>Uwaga:</strong> {cfg.message}
          {cfg.docsUrl && (
            <>
              {" "}
              <a href={cfg.docsUrl} target="_blank" rel="noopener noreferrer">
                {cfg.docsLabel ?? "Dokumentacja"}
              </a>
              .
            </>
          )}
        </Banner>
      ))
    }
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
