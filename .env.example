SUPABASE_URL=###
SUPABASE_KEY=###
# HMAC key for the parent_verified session marker (PIN gate: report page, deletion
# actions). Without it the gate fails closed — PIN routes 500 and the report is
# unreachable. Generate: openssl rand -hex 32
PARENT_SESSION_SECRET=###
# Service-role key — powers ONLY account self-deletion (/api/account/delete).
# Local: `npx supabase status -o env` → SERVICE_ROLE_KEY (public demo JWT).
# Production: Supabase dashboard → Settings → API; the server env file only.
# Absent → the deletion route answers 503 (fails closed).
SUPABASE_SERVICE_ROLE_KEY=###
# Bearer secret for /api/keep-alive. Unused since production Supabase is
# self-hosted (no auto-pause, no scheduled ping); unset, the route answers 401
# (fails closed). Not needed locally.
CRON_SECRET=###
# Anthropic API key — powers ONLY the code-review agent (packages/code-reviewer),
# locally and as the CI review gate (.github/workflows/review.yml, where it comes
# from the ANTHROPIC_API_KEY repository Actions secret — keep the two in sync).
# The app never reads it (not in astro.config env.schema).
# Get one from the Anthropic Console (commercial terms): https://console.anthropic.com
ANTHROPIC_API_KEY=###
